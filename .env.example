# Configuración de entorno para Automóviles Santillán
# Para desarrollo local o despliegue en Coolify

# En producción en Coolify cambiar DEBUG a False
DEBUG=False
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-segura-en-produccion

# Dominios permitidos (separados por coma). Ejemplo para Coolify:
ALLOWED_HOSTS=santillan.tudominio.com,localhost,127.0.0.1

# Orígenes confiables para CSRF (requerido para formularios con dominio y HTTPS en Coolify)
CSRF_TRUSTED_ORIGINS=https://santillan.tudominio.com

# Base de datos PostgreSQL provista por Coolify
# Coolify provee automáticamente la variable DATABASE_URL si agregas un servicio PostgreSQL
DATABASE_URL=postgres://postgres:password_seguro@postgres:5432/santillan_db

# Alternativa: Variables individuales de PostgreSQL
# DB_NAME=santillan_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=postgres
# DB_PORT=5432
