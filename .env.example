# Configuración de entorno para Automóviles Santillán
DEBUG=True
SECRET_KEY=django-insecure-santillan-change-in-production-key-xyz123
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexión a Base de Datos PostgreSQL
# Opción 1: Mediante URL de conexión (formato: postgres://usuario:password@host:puerto/nombre_bd)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/santillan_db

# Opción 2: Variables individuales (se usan si DATABASE_URL no está definida)
DB_NAME=santillan_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

